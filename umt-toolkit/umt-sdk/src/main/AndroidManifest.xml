<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets an integrated app reply to the toolkit on Android 11+ (package visibility). -->
    <queries>
        <package android:name="com.umt.toolkit" />
        <package android:name="com.umt.toolkit.debug" />
    </queries>

    <application>
        <receiver
            android:name="com.umt.sdk.UmtCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.umt.sdk.action.COMMAND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
