<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app's icon: talk straight away, or start a new chat. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="talk"
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_talk"
        android:shortcutShortLabel="@string/shortcut_talk"
        android:shortcutLongLabel="@string/shortcut_talk_long">
        <intent
            android:action="app.offlineai.chat.action.TALK"
            android:targetPackage="app.offlineai.chat"
            android:targetClass="app.offlineai.chat.ui.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="new_chat"
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_new"
        android:shortcutShortLabel="@string/shortcut_new"
        android:shortcutLongLabel="@string/shortcut_new_long">
        <intent
            android:action="app.offlineai.chat.action.NEW_CHAT"
            android:targetPackage="app.offlineai.chat"
            android:targetClass="app.offlineai.chat.ui.MainActivity" />
    </shortcut>
</shortcuts>
