@@ -5,7 +5,87 @@
 #include "simd-mappings.h"
 
 // TODO: add support for sizeless vector types
-#if defined(GGML_SIMD) && !defined(__ARM_FEATURE_SVE) && !defined(__riscv_v)
+#if defined(__ARM_FEATURE_SVE) && defined(__ARM_NEON) && defined(__aarch64__)
+// Offline AI: SVE builds (Android's armv9 variants, picked on phones with SVE2) fell through to
+// the scalar product below, which made ggml's tiled flash attention (every prompt of 64 tokens
+// or more) several times slower there than on older phones. NEON is there as well: 4x16 tiles of
+// 128-bit vectors, as in the NEON build.
+#include <arm_neon.h>
+
+template <int RM, int RN>
+static inline void simd_gemm_ukernel_neon(float * GGML_RESTRICT C, const float * GGML_RESTRICT A, const float * GGML_RESTRICT B, int K, int N) {
+    float32x4_t acc[RM][RN];
+    for (int i = 0; i < RM; i++) {
+        for (int r = 0; r < RN; r++) {
+            acc[i][r] = vld1q_f32(C + i * N + r * 4);
+        }
+    }
+    for (int kk = 0; kk < K; kk++) {
+        float32x4_t b[RN];
+        for (int r = 0; r < RN; r++) {
+            b[r] = vld1q_f32(B + kk * N + r * 4);
+        }
+        for (int i = 0; i < RM; i++) {
+            const float32x4_t a = vdupq_n_f32(A[i * K + kk]);
+            for (int r = 0; r < RN; r++) {
+                acc[i][r] = vfmaq_f32(acc[i][r], b[r], a);
+            }
+        }
+    }
+    for (int i = 0; i < RM; i++) {
+        for (int r = 0; r < RN; r++) {
+            vst1q_f32(C + i * N + r * 4, acc[i][r]);
+        }
+    }
+}
+
+template <int RM>
+static inline void simd_gemm_tail_neon(float * GGML_RESTRICT C, const float * GGML_RESTRICT A, const float * GGML_RESTRICT B, int K, int N, int cols) {
+    for (int j = 0; j < cols; j++) {
+        for (int i = 0; i < RM; i++) {
+            float a = C[i * N + j];
+            for (int kk = 0; kk < K; kk++) {
+                a += A[i * K + kk] * B[kk * N + j];
+            }
+            C[i * N + j] = a;
+        }
+    }
+}
+
+// C[M x N] += A[M x K] * B[K x N]
+static void simd_gemm(float * GGML_RESTRICT C, const float * GGML_RESTRICT A, const float * GGML_RESTRICT B, int M, int K, int N) {
+    int ii = 0;
+    for (; ii + 4 <= M; ii += 4) {
+        int jj = 0;
+        for (; jj + 16 <= N; jj += 16) {
+            simd_gemm_ukernel_neon<4, 4>(C + jj, A, B + jj, K, N);
+        }
+        for (; jj + 4 <= N; jj += 4) {
+            simd_gemm_ukernel_neon<4, 1>(C + jj, A, B + jj, K, N);
+        }
+        if (jj < N) {
+            simd_gemm_tail_neon<4>(C + jj, A, B + jj, K, N, N - jj);
+        }
+        A += 4 * K;
+        C += 4 * N;
+    }
+    for (; ii < M; ii++) {
+        int jj = 0;
+        for (; jj + 16 <= N; jj += 16) {
+            simd_gemm_ukernel_neon<1, 4>(C + jj, A, B + jj, K, N);
+        }
+        for (; jj + 4 <= N; jj += 4) {
+            simd_gemm_ukernel_neon<1, 1>(C + jj, A, B + jj, K, N);
+        }
+        if (jj < N) {
+            simd_gemm_tail_neon<1>(C + jj, A, B + jj, K, N, N - jj);
+        }
+        A += K;
+        C += N;
+    }
+}
+
