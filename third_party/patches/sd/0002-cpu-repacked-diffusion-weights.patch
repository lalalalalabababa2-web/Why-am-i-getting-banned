+ggml_backend_buffer_type_t ModelManager::repack_buffer_type_for(const TensorState& state) const {
+    // Only the diffusion model: it runs every step. Text encoders run once a picture and stay
+    // mmapped, so their pages can be dropped instead of held in anonymous memory.
+    if (state.usage_op != GGML_OP_MUL_MAT || state.tensor == nullptr ||
+        (state.component != ModelComponent::Diffusion && state.component != ModelComponent::HighNoiseDiffusion) ||
+        state.residency_mode != ResidencyMode::ParamBackend || state.compute_backend == nullptr ||
+        state.compute_backend != state.params_backend || !sd_backend_is_cpu(state.compute_backend)) {
+        return nullptr;
+    }
+    const auto& extra = cpu_extra_buffer_types();
+    if (state.tensor->buffer != nullptr) {
+        ggml_backend_buffer_type_t current = ggml_backend_buffer_get_type(state.tensor->buffer);
+        return std::find(extra.begin(), extra.end(), current) != extra.end() ? current : nullptr;
+    }
+    ggml_backend_dev_t cpu_dev = ggml_backend_get_device(state.compute_backend);
+    for (ggml_backend_buffer_type_t buft : extra) {
+        if (device_supports_param_op(cpu_dev, state.tensor, GGML_OP_MUL_MAT, buft)) {
+            return buft;
+        }
+    }
+    return nullptr;
+}
