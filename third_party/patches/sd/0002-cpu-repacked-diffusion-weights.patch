+// The CPU's extra buffer types (llama.cpp's repacked layouts) for its matmul kernels, which run
+// several times faster than the plain ggml layout on ARM. SD_CPU_REPACK=0 turns them off.
+static const std::vector<ggml_backend_buffer_type_t>& cpu_extra_buffer_types() {
+    static const std::vector<ggml_backend_buffer_type_t> types = [] {
+        std::vector<ggml_backend_buffer_type_t> out;
+        const char* env = std::getenv("SD_CPU_REPACK");
+        if (env != nullptr && std::strcmp(env, "0") == 0) {
+            return out;
+        }
+        ggml_backend_dev_t cpu = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+        ggml_backend_reg_t reg = cpu != nullptr ? ggml_backend_dev_backend_reg(cpu) : nullptr;
+        auto get_extra_bufts   = reg != nullptr ? (ggml_backend_dev_get_extra_bufts_t)ggml_backend_reg_get_proc_address(reg, "ggml_backend_dev_get_extra_bufts") : nullptr;
+        if (get_extra_bufts != nullptr) {
+            for (ggml_backend_buffer_type_t* buft = get_extra_bufts(cpu); buft != nullptr && *buft != nullptr; ++buft) {
+                out.push_back(*buft);
+            }
+        }
+        return out;
+    }();
+    return types;
+}
