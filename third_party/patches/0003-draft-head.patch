 }
 
+void llama_model_set_draft_head(llama_model * model, ggml_tensor * w, ggml_tensor * ids) {
+    const ggml_tensor * head = model->output;
+    if (w && ids && (!head || ids->type != GGML_TYPE_I32 || ids->ne[0] != w->ne[1] || w->ne[0] != head->ne[0] ||
+                     w->ne[1] > head->ne[1])) {
+        w = ids = nullptr;  // not a head this model can use
+    }
+    model->output_dft     = w && ids ? w   : nullptr;
+    model->output_dft_ids = w && ids ? ids : nullptr;
+}
+
 int32_t llama_model_dflash_selector_top_k(const llama_model * model) {
     return model->hparams.dflash_selector_top_k;
 }
