@@ -1458,3 +1458,8 @@
 
 // TODO: better name
 int32_t llama_relative_position_bucket(llama_pos x, llama_pos y, uint64_t n_buckets, bool bidirectional);
+
+// [Offline AI] Logits from a drafting head that has the rows of some tokens only (w: [n_embd, n_dft],
+// ids: [n_dft] I32): those tokens get their logits, every other one -inf. cur: [n_embd, n_out].
+// Returns [n_vocab, n_out], what the whole head would give for the tokens it has.
+ggml_tensor * llama_build_draft_logits(ggml_context * ctx, ggml_tensor * w, ggml_tensor * ids, ggml_tensor * cur, int64_t n_vocab);
diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -4249,3 +4249,20 @@
 
     return relative_bucket;
 }
+
+ggml_tensor * llama_build_draft_logits(ggml_context * ctx, ggml_tensor * w, ggml_tensor * ids, ggml_tensor * cur, int64_t n_vocab) {
+    ggml_tensor * sub = ggml_mul_mat(ctx, w, cur); // [n_dft, n_out]
+    const int64_t n_dft = sub->ne[0];
+    const int64_t n_out = sub->ne[1];
+
+    // every token -inf first (filled a whole row of the vocabulary at a time), then the rows of the
+    // tokens the head has, put in by token: rows of n_out values each
+    ggml_tensor * full = ggml_fill_inplace(ctx, ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_vocab, n_out), -INFINITY);
+    if (n_out == 1) {
+        ggml_tensor * dst = ggml_set_rows(ctx, ggml_reshape_2d(ctx, full, 1, n_vocab), ggml_reshape_2d(ctx, sub, 1, n_dft), ids);
+        return ggml_reshape_2d(ctx, dst, n_vocab, 1);
+    }
+    ggml_tensor * dst = ggml_set_rows(ctx, ggml_cont(ctx, ggml_transpose(ctx, full)),
+                                      ggml_cont(ctx, ggml_transpose(ctx, sub)), ids); // [n_out, n_vocab]
+    return ggml_cont(ctx, ggml_transpose(ctx, dst)); // [n_vocab, n_out]
+}
